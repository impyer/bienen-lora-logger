# Dieses Beispiel kopieren als .env und mit chmod 600 schützen.
# IP-Adresse der ThinkStation IM HEIMNETZ, nicht 0.0.0.0!
LAN_BIND_IP=192.168.1.50
# Hier NUR das eigene Heimnetz, z.B. 192.168.1.0/24.
LAN_ALLOWED_CIDR=192.168.1.0/24
LAN_PORT=8443
# Zwei getrennte, mit openssl rand -hex 32 erzeugte Geheimnisse.
BL_DB_PASSWORD=ERSETZEN_DURCH_HEX_AUS_OPENSSL
BL_SESSION_SECRET=ERSETZEN_DURCH_ANDERES_HEX_AUS_OPENSSL
