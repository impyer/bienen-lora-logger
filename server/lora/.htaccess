# Apache 2.4: nur lora_eingang.php ist von außen erreichbar
<FilesMatch ".*">
  Require all denied
</FilesMatch>
<Files "lora_eingang.php">
  Require all granted
</Files>
# Dashboard hat eigene Session-Passwortprüfung; niemals ungeschützt per Proxy veröffentlichen.
<Files "beep_dashboard.php">
  Require all granted
</Files>
